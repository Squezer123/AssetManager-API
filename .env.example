# Ta sama baza danych co aplikacja Next.js
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wypozyczenia"

# Sekret do podpisywania JWT - wygeneruj cos losowego, np: openssl rand -base64 32
JWT_SECRET="zmien-to-na-losowy-sekret"

# Port na ktorym startuje backend Nest (Next.js zwykle stoi na 3000, wiec inny port)
PORT=3001

# Adres frontendu Next.js - potrzebny do konfiguracji CORS
FRONTEND_URL="http://localhost:3000"
